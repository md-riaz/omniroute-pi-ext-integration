{
  "name": "omniroute-agent-extension",
  "version": "3.0.0",
  "description": "OmniRoute extension for Pi Coding Agent (pi) and Oh My Pi (omp) — model sync and prompt-tool fallback for chat-only models",
  "keywords": [
    "omp-plugin",
    "oh-my-pi",
    "pi-package",
    "pi-coding-agent",
    "omniroute",
    "llm",
    "ai-gateway",
    "extension"
  ],
  "type": "module",
  "files": [
    "shared.ts",
    "omp.ts",
    "pi.ts",
    "README.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./omp.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./pi.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --types node shared.ts omp.ts pi.ts",
    "smoke": "node --experimental-strip-types -e \"import('./omp.ts').then(()=>console.log('omp ok')).catch(e=>{console.error(e);process.exit(1)})\" && node --experimental-strip-types -e \"import('./pi.ts').then(()=>console.log('pi ok')).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "author": "md-riaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md-riaz/omniroute-agent-extension.git"
  },
  "homepage": "https://github.com/md-riaz/omniroute-agent-extension#readme",
  "bugs": {
    "url": "https://github.com/md-riaz/omniroute-agent-extension/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.60.0",
    "@oh-my-pi/pi-coding-agent": ">=0.60.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^15.8.3",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
